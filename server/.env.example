# server/.env 의 본보기. 실제 값과 경로는 server/.env 에만 쓴다(git에서 뺐다).
# 줄마다 위의 설명을 보고 이 맥에 맞게 채운다. 기본값이 있는 줄은 비워 두거나 지워도 그 기본값이 된다.

# 앱이 보내는 토큰. 32자 이상. 만들기: python3 -c "import secrets; print(secrets.token_hex(24))"
JE_TOKEN=

# 서버가 붙을 주소와 포트. 비우면 127.0.0.1 과 8787
# 시험 때는 127.0.0.1, 집 밖에서 쓸 때는 맥의 Tailscale 주소(ADR-0007). 주소는 맥에서 tailscale ip -4 로 본다
JE_HOST=127.0.0.1
JE_PORT=8787

# 녹음과 기록을 두는 폴더. 비우면 맥의 앱 데이터 폴더(~/Library/Application Support/jake-english)
# 열고 지우는 법은 server/README.md 「녹음과 기록」
JE_DATA_DIR=

# 맥의 기존 음성 합성 환경: 그 venv의 파이썬과 처리 코드 파일(ADR-0009)
JE_TTS_PYTHON=
JE_TTS_MODULE=

# 받아쓰기: whisper.cpp 의 whisper-server 와 large-v3 모델 파일의 경로
# JE_WHISPER_SERVER 를 비우면 PATH 의 whisper-server, JE_WHISPER_PORT 를 비우면 8788
JE_WHISPER_SERVER=whisper-server
JE_WHISPER_MODEL=
JE_WHISPER_PORT=8788

# 인물 그림(라이언, 소희, 제이크) 폴더. 비우면 저장소의 server/assets/(ADR-0015)
# 다른 폴더의 그림을 쓸 때만 값을 준다(예: 새 그림을 커밋하기 전에 맥에서 시험할 때)
JE_ASSETS_DIR=

# Claude API 키는 저장소 맨 위 .env 의 ANTHROPIC_API_KEY 를 읽는다. 여기에 다시 쓰지 않아도 된다.

# Claude 모델. 비우면 기본값(말하기 연습 스펙 「기다리는 시간과 모델」)
# 글쓰기(대본, 세 줄 설명, 대본 밖 말에 대답, 대본 이어 가기): haiku, sonnet, opus. 기본 sonnet
JE_CLAUDE_WRITER=
# 짧은 말(녹음 평가 글, 소희 통역): haiku, sonnet. 기본 haiku
JE_CLAUDE_QUICK=
# 제이크의 상황 추천: haiku, sonnet. 기본 sonnet
JE_CLAUDE_RECOMMEND=
# 자유 대화의 라이언: haiku, sonnet, opus. 기본 sonnet
JE_CLAUDE_TALK=
# 자유 대화의 소희 찬스(답 힌트): haiku, sonnet. 기본 sonnet
JE_CLAUDE_HINT=

# 강세 값 재기(scripts/measure_stress.py, 손으로 돌린다): MFA와 parselmouth가 든 micromamba 환경 폴더.
# 서버는 읽지 않는다. 비우면 스크립트가 알리고 멈춘다(docs/superpowers/specs/2026-11-08-stress-log-design.md)
JE_MFA_ENV=
